# Copy to .env and fill in a real value before running `docker compose up`.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Postgres (see docs/superpowers/plans/2026-07-13-postgres-foundation.md)
POSTGRES_PASSWORD=
# Used by the app and by `npm run db:migrate` outside Docker (host -> container via the published port).
DATABASE_URL=postgres://revision:changeme@127.0.0.1:5433/revision_app
# Used only by the test suite (npm test) — a separate database so tests never touch dev data.
TEST_DATABASE_URL=postgres://revision:changeme@127.0.0.1:5433/revision_app_test

# auth-service (services/auth-service) has its own database and reads the same
# DATABASE_URL var name, but scoped to its own process/container. When running
# it directly on the host (outside `docker compose up`), override DATABASE_URL
# before starting it or running its tests, e.g.:
#   export DATABASE_URL=postgres://revision:changeme@127.0.0.1:5433/revision_auth
#   export DATABASE_URL=postgres://revision:changeme@127.0.0.1:5433/revision_auth_test  # for npm test -w services/auth-service
# Inside docker-compose, auth-service's DATABASE_URL is set independently to
# point at revision_auth via the db service's internal hostname — see docker-compose.yml.

# Email sending (auth-service). Leave RESEND_API_KEY empty until the Resend
# account + sending domain are set up — auth-service then logs the
# verification/reset links to its stdout instead of sending real email
# (view them with: docker logs revision_auth_service).
RESEND_API_KEY=
FROM_EMAIL=
# Public base URL used inside emailed links.
FRONTEND_URL=http://127.0.0.1:3200
